# Copy this file to `.env` and adjust if needed.
# `npm run dev` works with the defaults below, so no .env is required to start.

# Port the Express API listens on
PORT=4000

# Comma-separated list of browser origins allowed to call the API.
# In production this is the deployed client origin, e.g. https://collegedost.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Session cookie SameSite policy. Local dev keeps `lax`; a deployment with the
# client and API on different origins (Vercel + Render) must use `none`.
COOKIE_SAME_SITE=lax

# Path to the SQLite file, relative to the server/ directory
DATABASE_FILE=data/collegedost.sqlite

# Secret used to sign session JWTs. Replace with a long random string.
JWT_SECRET=dev-only-change-me

# Session lifetime in days
JWT_EXPIRES_DAYS=7

# "development" enables verbose error payloads and request logging
NODE_ENV=development
